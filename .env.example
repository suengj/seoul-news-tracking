TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_SEND_ENABLED=false
DATABASE_PATH=data/seoul_news.db
LOG_LEVEL=INFO

# Service v1 polling (see docs/local_runtime.md) — a new message may be
# detected up to ~POLL_INTERVAL_SECONDS after it appears.
POLL_INTERVAL_SECONDS=300
STATUS_STALE_AFTER_MINUTES=15

# Retention (see docs/database_retention.md)
MESSAGE_RETENTION_DAYS=90
RUN_HISTORY_RETENTION_DAYS=14
STORE_SUCCESSFUL_NOOP_RUNS=false
CLEANUP_INTERVAL_HOURS=24
TOMBSTONE_RETENTION_DAYS=365

LOCAL_SHUTDOWN_COMMAND_ENABLED=false

# Historical backfill (safetydata.go.kr archive) — separate DB, see docs/history_backfill.md
HISTORY_DATABASE_PATH=data/history_raw.db
HISTORY_REQUEST_DELAY_SECONDS=1.5
HISTORY_REQUEST_TIMEOUT_SECONDS=20
HISTORY_MAX_RETRIES=3
HISTORY_TARGET_COUNT=10000

# Template recommendation engine (config/message_templates.yaml), see docs/template_engine.md
TEMPLATE_RECOMMEND_THRESHOLD=0.85

# On-demand AI slot extraction (only runs when an operator clicks "AI로
# 작성" — see docs/service_v1.md). The real key is provided separately by
# the operator; never commit a real value here.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
