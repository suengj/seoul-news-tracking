# TELEGRAM_CHAT_ID: LEGACY migration/bootstrap only (v0.4.0). It is NOT the
# normal automatic-alert recipient anymore. Automatic new-alert delivery now
# fans out independently to every active personal subscription stored in
# SQLite (telegram_subscriptions). This value is used only once, to seed an
# initial subscription when the table is empty and it can be matched safely
# to a single allowed user — see docs/independent_operator_model.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# TELEGRAM_ALLOWED_USER_IDS: comma-separated Telegram user IDs (not chat IDs)
# permitted to operate AND subscribe. Every authorized operator is an equal,
# independent entity: they each subscribe from their own private chat, get
# every new alert independently, and their commands/previews/AI/decisions are
# isolated. There is no primary/sub operator. Interactive replies always
# return to the originating private chat — see docs/independent_operator_model.md.
TELEGRAM_ALLOWED_USER_IDS=

# Global master switch for ALL automatic personal deliveries. It is NOT an
# individual user's mute state (use /mute per operator). When false, no
# automatic delivery occurs but interactive commands still work and personal
# subscription states are unchanged.
TELEGRAM_SEND_ENABLED=false
DATABASE_PATH=data/seoul_news.db
LOG_LEVEL=INFO

# Required by the Telegram getUpdates cutover fence in a real deployment.
# The fence path must be the same operator-provisioned shared directory on
# both hosts; the host id must be different on the two hosts.
DEPLOYMENT_LABEL=linux-production
RUNTIME_MODE=systemd
CUTOVER_FENCE_PATH=/path/to/shared/cutover-fence
CUTOVER_HOST_ID=linux

# Bounded worker pool for on-demand AI generation (range 1-4). Keeps one
# operator's AI request from blocking another operator's non-AI commands.
TELEGRAM_AI_WORKERS=2

# Service v1 polling (see docs/local_runtime.md) — a new message may be
# detected up to ~POLL_INTERVAL_SECONDS after it appears.
POLL_INTERVAL_SECONDS=300
STATUS_STALE_AFTER_MINUTES=15

# Retention (see docs/database_retention.md)
MESSAGE_RETENTION_DAYS=90
RUN_HISTORY_RETENTION_DAYS=14
STORE_SUCCESSFUL_NOOP_RUNS=false
CLEANUP_INTERVAL_HOURS=24
TOMBSTONE_RETENTION_DAYS=365

LOCAL_SHUTDOWN_COMMAND_ENABLED=false

# Historical backfill (safetydata.go.kr archive) — separate DB, see docs/history_backfill.md
HISTORY_DATABASE_PATH=data/history_raw.db
HISTORY_REQUEST_DELAY_SECONDS=1.5
HISTORY_REQUEST_TIMEOUT_SECONDS=20
HISTORY_MAX_RETRIES=3
HISTORY_TARGET_COUNT=10000

# Template recommendation engine (config/message_templates.yaml), see docs/template_engine.md
TEMPLATE_RECOMMEND_THRESHOLD=0.85

# On-demand AI slot extraction (only runs when an operator clicks "AI로
# 작성" — see docs/service_v1.md). The real key is provided separately by
# the operator; never commit a real value here.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2

# v0.5.0 live source: 행정안전부(MOIS) SafetyData Open API (primary) +
# 국민안전24 HTML (conditional fallback only, same poll cycle, on primary
# hard failure). See docs/live_source_migration_mois_api_plan.md and
# docs/mois_api_contract_confirmed.md. The real service key is provided
# separately by the operator; never commit a real value here. Missing key
# is a fail-fast configuration error, not a fallback trigger.
SAFETYDATA_SERVICE_KEY=
# Page size for DSSP-IF-00247 requests (1-1000, bounded by the confirmed API limit).
SAFETYDATA_NUM_OF_ROWS=100
# crtDt overlap window in days (KST today minus this many days), range 1-7.
SAFETYDATA_LOOKBACK_DAYS=1
# Conditional 국민안전24 HTML fallback, used only within the same poll cycle
# after a primary hard runtime failure. A valid empty primary result never
# triggers it.
SAFEKOREA_FALLBACK_ENABLED=true
SAFEKOREA_REQUEST_TIMEOUT_SECONDS=15
SAFEKOREA_MAX_PAGES=10
SAFEKOREA_REQUEST_DELAY_SECONDS=0.3
